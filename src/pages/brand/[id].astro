---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import Empty from "../../components/Empty.astro";
import { BRANDS, BRAND_BY_ID, CATEGORIES, PRODUCTS, SORTS } from "../../data/catalog";

export function getStaticPaths() {
  return BRANDS.map((b) => ({ params: { id: b.id } }));
}
const b = BRAND_BY_ID[Astro.params.id!];
const list = PRODUCTS.filter((p) => p.brand === b.id);
---
<Base title={`${b.name} — Kedai`} description={b.tagline}>
  <div class="container page" id="brand" data-id={b.id} data-name={b.name}>
    <header class="bhead">
      <button class="bhead__follow" id="follow" aria-pressed="false">Follow</button>
      <h1>{b.name}</h1>
      <div class="bhead__rating">{b.rating} <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M5 .5l1.2 2.9 3.1.3-2.4 2 .8 3.1L5 7.2 2.3 8.8l.8-3.1-2.4-2 3.1-.3z" /></svg> {b.reviews.toLocaleString("en-US")} Reviews</div>
      <p class="bhead__tag">{b.tagline} · <a href={`/category/${b.cat}`} style="text-decoration:underline">{CATEGORIES[b.cat].label}</a></p>
    </header>

    <section class="bsec">
      <h2 class="sub">Products</h2>
      <div class="toolbar">
        <label class="select"><span class="sr">Sort by</span>
          <select id="sortSel" aria-label="Sort by">{Object.entries(SORTS).map(([k, l]) => <option value={k}>{l === "Featured" ? "Sort by" : l}</option>)}</select>
        </label>
        <button class="chip" id="saleBtn" aria-pressed="false">On sale</button>
        <label class="select"><span class="sr">Price</span>
          <select id="priceSel" aria-label="Filter by price"><option value="">Price</option><option value="0-50">Under $50</option><option value="50-100">$50 – $100</option><option value="100-9999">Over $100</option></select>
        </label>
        <span class="toolbar__count" id="count">{list.length} products</span>
      </div>
      <div class="pgrid" id="grid">{list.map((p) => <ProductCard p={p} hideBrand />)}</div>
      <div id="none" hidden><Empty title="No matches" text="Try a different price range." /></div>
    </section>
  </div>
  <script>
    import { $, follows, toast } from "../../scripts/store";
    import { initGrid } from "../../scripts/grid";
    initGrid();
    const root = $("#brand")!, id = root.dataset.id!, name = root.dataset.name!, btn = $("#follow")!;
    const paint = () => { const on = follows.has(id); btn.textContent = on ? "Following" : "Follow"; btn.setAttribute("aria-pressed", String(on)); };
    paint();
    btn.addEventListener("click", () => { toast(follows.toggle(id) ? `Following ${name}` : `Unfollowed ${name}`); paint(); });
  </script>
</Base>
